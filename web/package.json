{
  "name": "shrutdhara",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/prepare-assets.mjs",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "node scripts/prepare-assets.mjs && ng build && node scripts/build-worker.mjs",
    "preview": "node scripts/serve.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "e2e": "node --test e2e/listen.e2e.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "idb": "8.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-range-requests": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8",
    "playwright-core": "^1.56.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "5.1.1"
  }
}
